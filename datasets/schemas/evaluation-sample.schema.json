{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resolve.local/schemas/evaluation-sample.json",
  "title": "RESOLVE evaluation sample",
  "type": "object",
  "required": ["sample_key", "case_context", "expected_exception_types", "expected_root_cause"],
  "properties": {
    "sample_key": { "type": "string", "minLength": 1, "maxLength": 80 },
    "case_context": { "type": "object" },
    "expected_exception_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expected_root_cause": { "type": "string" },
    "expected_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quote"],
        "properties": {
          "quote": { "type": "string" },
          "source_type": { "type": "string" }
        }
      }
    },
    "expected_recommendations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}