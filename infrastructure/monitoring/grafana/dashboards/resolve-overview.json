      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(resolve_http_requests_total[5m]))",
          "legendFormat": "Requests by route"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
