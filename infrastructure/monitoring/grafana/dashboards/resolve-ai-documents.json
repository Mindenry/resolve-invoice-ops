        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"blackbox\", instance=\"http://host.docker.internal:11434/api/version\"}",
          "legendFormat": "Ollama probe"
