    {
      "id": 5,
      "type": "timeseries",
      "title": "Investigation request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(resolve_http_requests_total{route=~\".*investigations.*\"}[5m]))",
          "legendFormat": "Investigation request rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Processing latency proxy",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
