{
  "id": "resolve-a-new-exception",
  "name": "RESOLVE A - New exception and case notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "resolve/new-exception",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "wh-a",
      "name": "RESOLVE event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "wh-a"
    },
    {
      "parameters": {
        "jsCode": "// Verify the RESOLVE HMAC-SHA256 signature over the exact raw request body and\n// validate the payload schema. Idempotency is enforced separately against the\n// RESOLVE claim store (Redis) so retried deliveries cannot be processed twice.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst raw = item.binary && item.binary.data && item.binary.data.data\n  ? Buffer.from(item.binary.data.data, 'base64').toString('utf8')\n  : JSON.stringify(item.json.body || {});\nconst signature = String(headers['x-resolve-signature'] || headers['X-Resolve-Signature'] || '');\nconst secret = $env.RESOLVE_N8N_WEBHOOK_SECRET || '';\nif (!secret) { throw new Error('RESOLVE_N8N_WEBHOOK_SECRET is not configured in n8n'); }\nconst expected = crypto.createHmac('sha256', secret).update(raw, 'utf8').digest('hex');\nif (!signature || signature.length !== expected.length ||\n    !crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(signature))) {\n  throw new Error('Invalid RESOLVE webhook signature');\n}\nlet payload;\ntry {\n  payload = JSON.parse(raw);\n} catch (error) {\n  throw new Error('Malformed RESOLVE payload: expected JSON');\n}\nif (!payload || typeof payload !== 'object' || !payload.id || !payload.event_type) {\n  throw new Error('Malformed RESOLVE payload: id and event_type are required');\n}\nreturn [{\n  json: {\n    signature_valid: true,\n    event_id: payload.id,\n    event_type: payload.event_type,\n    occurred_at: payload.occurred_at || null,\n    entity_type: payload.entity_type || null,\n    entity_id: payload.entity_id || null,\n    data: payload.data || {},\n  },\n}];",
        "mode": "runOnceForAllItems"
      },
      "id": "code-a",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/v1/internal/automation/claims",
        "options": {
          "timeout": 8000,
          "redirect": {
            "redirect": {}
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Secret",
              "value": "={{ $env.RESOLVE_N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ key: $json.event_id }) }}"
      },
      "id": "http-claims-a",
      "name": "Claim event id",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Re-attach the verified event to the idempotency verdict. A repeated delivery\n// of the same event id gets claimed=false and is answered as a duplicate.\nconst event = $('Verify signature').first().json;\nconst claim = $json || {};\nreturn [{ json: { ...event, claimed: claim.claimed === true } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "code-a-merge",
      "name": "Merge claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-a-cond",
              "leftValue": "={{ !$json.claimed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-a",
      "name": "Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'duplicate', event_id: $json.event_id }) }}",
        "options": {}
      },
      "id": "resp-a-dup",
      "name": "Respond duplicate",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        -140
      ]
    },
    {
      "parameters": {
        "fromEmail": "automation@resolve.local",
        "toEmail": "ops@resolve.local",
        "subject": "=RESOLVE {{$json.event_type}} - {{$json.data.title || $json.data.case_number || $json.event_id}}",
        "emailFormat": "text",
        "text": "={{ ['RESOLVE automation notification','Event: ' + $json.event_type,'Event ID: ' + $json.event_id,'Occurred: ' + ($json.occurred_at || 'n/a'),'Entity: ' + ($json.entity_type || 'n/a') + ' ' + ($json.entity_id || ''),'Severity: ' + ($json.data.severity || 'n/a'),'Priority: ' + ($json.data.priority || 'n/a'),'Title: ' + ($json.data.title || $json.data.case_number || 'n/a'),'Details: ' + JSON.stringify($json.data)].join('\\n') }}",
        "options": {}
      },
      "id": "mail-a",
