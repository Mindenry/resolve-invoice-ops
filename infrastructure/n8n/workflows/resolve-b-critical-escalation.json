        "toEmail": "ops@resolve.local",
        "subject": "=RESOLVE ESCALATION {{$json.priority}} {{$json.case_number}}",
        "emailFormat": "text",
        "text": "={{ ['RESOLVE critical case escalation','Case: ' + $json.case_number + ' - ' + $json.title,'Case ID: ' + $json.case_id,'Priority: ' + $json.priority,'Status: ' + $json.status,'Due at: ' + ($json.due_at || 'n/a'),'SLA breached: ' + $json.sla_breached,'Overdue: ' + $json.overdue,'Reason: ' + $json.reason,'Event ID: ' + $json.event_id,'Action: assign an owner and approve a resolution through RESOLVE (n8n never approves or executes).'].join('\\n') }}",
        "options": {}
      },
