    },
    {
      "parameters": {
        "jsCode": "// RESOLVE signs the raw body with HMAC-SHA256.\n// Configure this comparison in production; this template only forwards validated payloads.\nconst crypto = require('crypto');\nconst secret = $env.RESOLVE_WEBHOOK_SECRET || '';\nconst header = $json.headers?.['x-resolve-signature'] || '';\nif (secret && header) {\n  const raw = $json.rawBody || JSON.stringify($json.body || {});\n  const expected = crypto.createHmac('sha256', secret).update(raw).digest('hex');\n  if (expected !== header) { throw new Error('Invalid RESOLVE signature'); }\n}\nreturn [{ json: { ...($json.body || $json), received_at: new Date().toISOString(), audience: 'Operations duty manager' } }];\n"
      },
      "id": "node-verify-1",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RESOLVE_OPS_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: 'RESOLVE: High priority case escalation', event: $json }) }}",
        "options": {
          "timeout": 10000
        }
      },
