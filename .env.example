# RESOLVE environment template.
# Copy to .env and fill every blank secret. Generate values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the filled .env.

# ---------- Application ----------
ENV=production
DEBUG=false
SECRET_KEY=
APP_NAME=RESOLVE API
API_V1_PREFIX=/api/v1
FRONTEND_URL=https://localhost:8180
CORS_ORIGINS=https://localhost:8180,https://127.0.0.1:8180,https://resolve.local:8180
LOG_LEVEL=INFO
LOG_JSON=false
DEMO_MODE=false
AUTO_CREATE_SCHEMA=false

# ---------- Database ----------
POSTGRES_DB=resolve
POSTGRES_USER=resolve
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://resolve:CHANGE_ME@postgres:5432/resolve
DB_ECHO=false
DB_POOL_SIZE=5

# ---------- Cache / background jobs ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
TASK_RUNNER=celery
CELERY_TASK_ALWAYS_EAGER=false
TASK_INLINE_MAX_CONCURRENCY=3

# ---------- Security ----------
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=10
ALLOW_SELF_APPROVAL=false
APPROVAL_EXPIRY_HOURS=48
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=600/minute
RATE_LIMIT_LOGIN=20/minute
RATE_LIMIT_STORAGE_URI=memory://
MAX_UPLOAD_MB=25
# Optional explicit key for integration credential encryption (derived from SECRET_KEY if blank)
CREDENTIAL_ENCRYPTION_KEY=

# ---------- Storage (SeaweedFS / S3) ----------
STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=/app/var/storage
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=resolve-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# ---------- Document processing ----------
OCR_ENABLED=true
OCR_PROVIDER=tesseract
TESSERACT_CMD=
OCR_LANGUAGE=eng+tha
OCR_MIN_TEXT_CHARS_PER_PAGE=80
OCR_TIMEOUT_SECONDS=90
PDF_RENDER_DPI=200
MAX_DECOMPRESSED_MB=200
DOCUMENT_DETAIL_MAX_CHARS=60000

# ---------- AI ----------
# AI_PROVIDER: none | openai | ollama | stub   (stub is for automated tests only)
AI_PROVIDER=ollama
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=
AI_MODEL=qwen2.5:7b-instruct
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_TEMPERATURE=0
AI_MAX_OUTPUT_TOKENS=2500
AI_INPUT_COST_PER_1K=0
AI_OUTPUT_COST_PER_1K=0
AI_EXTRACTION_ENABLED=true
AI_INVESTIGATION_ENABLED=true

AI_EMBEDDING_PROVIDER=ollama
AI_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=bge-m3
AI_EMBEDDING_DIM=1024

# ---------- Retrieval ----------
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.18
KEYWORD_WEIGHT=0.45
VECTOR_WEIGHT=0.55

# ---------- Email (Mailpit locally; replace for real delivery) ----------
EMAIL_BACKEND=smtp
EMAIL_FROM=resolve@resolve.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_SINK_DIR=/app/var/mail

# ---------- Automation ----------
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=3
SEED_DEMO=false

# Read-only account used by n8n workflows (create once, then paste here).
RESOLVE_AUTOMATION_EMAIL=automation@example.com
RESOLVE_AUTOMATION_PASSWORD=
RESOLVE_AUTOMATION_ORG_ID=
RESOLVE_ORGANIZATION_SLUG=northwind

# ---------- n8n ----------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=false
N8N_ENCRYPTION_KEY=
N8N_OWNER_EMAIL=owner@resolve.local
N8N_OWNER_PASSWORD=
N8N_EXECUTIONS_MAX_AGE_HOURS=168
GENERIC_TIMEZONE=Asia/Bangkok

# ---------- Monitoring ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=
PROMETHEUS_PORT=9190
GRAFANA_PORT=3101
ALERTMANAGER_PORT=9193

# Compose host ports (isolated from native services)
API_PORT=8100
WEB_PORT=8180
WEB_HTTP_PORT=8081
POSTGRES_PORT=5433
REDIS_PORT=6380
# SeaweedFS S3 gateway / master UI (bound to 127.0.0.1 in Compose)
S3_PORT=9100
S3_CONSOLE_PORT=9101
MAILPIT_PORT=8125
MAILPIT_SMTP_PORT=1126
N8N_PORT_HOST=5679
